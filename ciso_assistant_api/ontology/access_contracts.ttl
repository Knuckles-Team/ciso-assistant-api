@prefix ac: <https://knuckles-team.github.io/ontology/access#> .
@prefix : <https://knuckles-team.github.io/ontology/connector/ciso-assistant#> .
@prefix ca: <https://knuckles-team.github.io/ontology/connector/ciso-assistant/access#> .

ca:appliedControlAccess a ac:AccessContract ;
    ac:classIri :Control ;
    ac:sourceId "ciso-assistant-api" ;
    ac:entity "applied_control" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "ciso_assistant_api_applied_controls_list" ;
    ac:pagination "page" ;
    ac:recordsPath "data" ;
    ac:paginationParam "page" ;
    ac:pageSizeParam "limit" ;
    ac:freshnessSeconds 300 ;
    ac:costHint "low" .

ca:appliedControlStatus a ac:PropertyBinding ;
    ac:contract ca:appliedControlAccess ; ac:property :controlStatus ; ac:field "status" .
ca:appliedControlRiskScenarioId a ac:PropertyBinding ;
    ac:contract ca:appliedControlAccess ; ac:property :riskScenarioId ; ac:field "risk_scenarios" .

ca:riskScenarioAccess a ac:AccessContract ;
    ac:classIri :RiskScenario ;
    ac:sourceId "ciso-assistant-api" ;
    ac:entity "risk_scenario" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "ciso_assistant_api_risk_scenarios_list" ;
    ac:pagination "page" ;
    ac:recordsPath "data" ;
    ac:paginationParam "page" ;
    ac:pageSizeParam "limit" ;
    ac:freshnessSeconds 300 ;
    ac:costHint "low" .

ca:riskScenarioServiceRef a ac:PropertyBinding ;
    ac:contract ca:riskScenarioAccess ; ac:property :serviceRef ; ac:field "assets" .
ca:riskScenarioName a ac:PropertyBinding ;
    ac:contract ca:riskScenarioAccess ; ac:property :name ; ac:field "name" .
