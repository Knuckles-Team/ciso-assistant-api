# ─── CISO Assistant connection ───────────────────────────────────────────────
# Remote deployments must use HTTPS. Loopback HTTP is accepted for local testing.
CISO_ASSISTANT_URL=https://service.example.invalid

# ─── Authentication references (never store secret values here) ─────
# Use a Knox token reference OR both username/password references.
CISO_ASSISTANT_TOKEN_REF=secret://connectors/ciso-assistant/token
# CISO_ASSISTANT_USERNAME_REF=secret://connectors/ciso-assistant/username
# CISO_ASSISTANT_PASSWORD_REF=secret://connectors/ciso-assistant/password

# ─── TLS profile selectors ────────────────────────────────────────
# Select a profile from AgentConfig, or reference one JSON TLS profile.
# CISO_ASSISTANT_TLS_PROFILE=enterprise-ca
# CISO_ASSISTANT_TLS_PROFILE_REF=secret://connectors/ciso-assistant/tls-profile

# ─── MCP transport / auth (scion-sdk) ────────────────────────────
FASTMCP_LOG_LEVEL=INFO
# TRANSPORT=stdio
# AUTH_TYPE=none

# ─── Tool-surface toggles ───────────────────────────────────────────────
# Each gates a tool group on/off via setting("<NAME>", True).
CUSTOM_APITOOL=False           # arbitrary REST escape hatch (explicit opt-in)
KG_INGESTTOOL=True             # governed native graph ingestion

# Deployment image references must be operator-approved immutable digests.
# Leave unset until configuring an actual deployment; no image is implied here.
CISO_ASSISTANT_MCP_IMAGE=
