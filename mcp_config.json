{
  "mcpServers": {
    "ciso-assistant-api": {
      "command": "uv",
      "args": [
        "run",
        "ciso-assistant-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "intent",
        "ANALYTICS_METROLOGYTOOL": "True",
        "ASSETSTOOL": "True",
        "AUTH_USERSTOOL": "True",
        "CHATTOOL": "True",
        "CISO_ASSISTANT_PASSWORD_REF": "secret://connectors/ciso-assistant/password",
        "CISO_ASSISTANT_TLS_PROFILE": "enterprise-ca",
        "CISO_ASSISTANT_TLS_PROFILE_REF": "secret://connectors/ciso-assistant/tls-profile",
        "CISO_ASSISTANT_TOKEN_REF": "secret://connectors/ciso-assistant/token",
        "CISO_ASSISTANT_URL": "https://service.example.invalid",
        "CISO_ASSISTANT_USERNAME_REF": "secret://connectors/ciso-assistant/username",
        "COMPLIANCETOOL": "True",
        "CRQTOOL": "True",
        "CUSTOM_APITOOL": "False",
        "EBIOS_RMTOOL": "True",
        "EVIDENCETOOL": "True",
        "FRAMEWORKS_LIBRARIESTOOL": "True",
        "GOVERNANCETOOL": "True",
        "INCIDENTSTOOL": "True",
        "INTEGRATIONSTOOL": "True",
        "KG_INGESTTOOL": "True",
        "PRIVACYTOOL": "True",
        "RESILIENCETOOL": "True",
        "RISK_MANAGEMENTTOOL": "True",
        "SECURITY_FINDINGSTOOL": "True",
        "SETTINGSTOOL": "True",
        "TASKS_TIMELINETOOL": "True",
        "THIRD_PARTYTOOL": "True"
      }
    }
  }
}
